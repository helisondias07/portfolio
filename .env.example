# All optional: the site builds and runs without them (newsletter replies "not_configured", visit beacon is a no-op).

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Helison Dias <oi@seudominio.com>".
# Without it, onboarding@resend.dev is used, which only delivers to the Resend account owner.
RESEND_FROM=
# Audience that stores newsletter contacts (Resend > Audiences). If empty, only the confirmation email is sent.
RESEND_AUDIENCE_ID=
# Where visit notifications go.
NOTIFY_EMAIL=helisondias07@gmail.com

# Upstash Redis (Vercel Marketplace > Upstash). Used for rate limit + 1 visit email per IP per day.
# Without it, limits are skipped (fail open). Vercel injects KV_REST_API_URL/TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional
IP_SALT=change-me
VISIT_DAILY_CAP=200
